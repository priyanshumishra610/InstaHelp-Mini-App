{
  "name": "@instahelp/cms",
  "version": "1.0.0",
  "private": true,
  "description": "InstaHelp Dynamic Content Management System",
  "scripts": {
    "dev:api": "npm run dev --prefix api",
    "dev:admin": "npm run dev --prefix admin",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:admin\"",
    "build:api": "npm run build --prefix api",
    "build:admin": "npm run build --prefix admin",
    "db:migrate": "npm run db:migrate --prefix api",
    "db:seed": "npm run db:seed --prefix api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
