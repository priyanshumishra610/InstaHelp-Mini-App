# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/instahelp_cms

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Redis (optional — API works without it)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=instahelp-cms

# Default super admin (created on first seed)
ADMIN_EMAIL=admin@instahelp.in
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Super Admin

# Mobile API key (optional rate-limit bypass for app)
MOBILE_API_KEY=
