{
  "expo": {
    "name": "InstaHelp",
    "slug": "instahelp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": [
      "instahelpminiapp",
      "instahelpmobileapp"
    ],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.instahelp.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "in.instahelp.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/InstaHelp.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow InstaHelp to attach one photo to your request when useful.",
          "cameraPermission": "Allow InstaHelp to capture a photo for your request."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow InstaHelp to use your location so we can prefill your service address.",
          "locationWhenInUsePermission": "Allow InstaHelp to use your location so we can prefill your service address.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#171717",
          "defaultChannel": "instahelp-local-demand",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6513857875305294~9603037789",
          "iosAppId": "ca-app-pub-6513857875305294~9603037789",
          "userTrackingUsageDescription": "This identifier is used to deliver personalized ads that help you earn vendor credits."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "publicEnv": {
        "EXPO_PUBLIC_APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbxY3jUaZff3lpInIyOMxmy_vpRsueaghpf2ko8EQlrrVWERpG58pcFEQkDmLSxxxcq7/exec",
        "EXPO_PUBLIC_WHATSAPP_E164": "917022702220",
        "EXPO_PUBLIC_APP_WEB_URL": "https://instahelp.in",
        "EXPO_PUBLIC_LEGAL_TERMS_URL": "https://instahelp.in/terms",
        "EXPO_PUBLIC_LEGAL_PRIVACY_URL": "https://instahelp.in/privacy",
        "EXPO_PUBLIC_HUBBLE_CLIENT_ID": "instahelp-sdk-1z4JmIpo",
        "EXPO_PUBLIC_HUBBLE_APP_SECRET": "Ppo5udAi9CDXlN8nlPZoH8myUwAwsa7UgsKcxvxTeXrWZHhPMqACBhr7e4FDsaN4",
        "EXPO_PUBLIC_HUBBLE_ENV": "production",
        "EXPO_PUBLIC_SHOP_CATALOG_SOURCE": "live",
        "EXPO_PUBLIC_SHOP_SHEET_ID": "1XfPC6fcV_Ct97vDwaRJDVbZ2hJNQRvj2FWj0nddqwR4",
        "EXPO_PUBLIC_SHOP_PRODUCTS_GID": "0",
        "EXPO_PUBLIC_RAZORPAY_KEY_ID": "rzp_live_SxW7oDR9YnHxcV"
      },
      "eas": {
        "projectId": "06de5144-e873-4493-8832-06de0c28aa08"
      }
    },
    "owner": "priyanshum614",
    "updates": {
      "enabled": false
    },
    "runtimeVersion": "1.0.0"
  }
}
