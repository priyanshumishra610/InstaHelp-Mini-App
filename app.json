{
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-6513857875305294~9603037789",
    "ios_app_id": "ca-app-pub-6513857875305294~9603037789",
    "user_tracking_usage_description": "This identifier is used to deliver personalized ads that help you earn vendor credits."
  },
  "expo": {
    "name": "InstaHelp",
    "slug": "instahelp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": [
      "instahelpminiapp",
      "instahelpmobileapp"
    ],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.instahelp.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "in.instahelp.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/InstaHelp.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow InstaHelp to attach one photo to your request when useful.",
          "cameraPermission": "Allow InstaHelp to capture a photo for your request."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow InstaHelp to use your location so we can prefill your service address.",
          "locationWhenInUsePermission": "Allow InstaHelp to use your location so we can prefill your service address.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#004aad"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6513857875305294~9603037789",
          "iosAppId": "ca-app-pub-6513857875305294~9603037789",
          "userTrackingUsageDescription": "This identifier is used to deliver personalized ads that help you earn vendor credits."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa27befe-169d-44db-a09d-90b55c657cc7"
      }
    },
    "owner": "priyanshum567",
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
