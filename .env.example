# InstaHelp — public env template (do not put secrets in git)

# Apps Script + WhatsApp (existing)
# EXPO_PUBLIC_APPS_SCRIPT_URL=
# EXPO_PUBLIC_WHATSAPP_E164=

# Hubble Gift Card SDK
EXPO_PUBLIC_HUBBLE_CLIENT_ID=
EXPO_PUBLIC_HUBBLE_APP_SECRET=
# development | production (omit for production)
EXPO_PUBLIC_HUBBLE_ENV=development
# Optional: set to 1 to log Hubble analytics events in dev consoles
# EXPO_PUBLIC_HUBBLE_ANALYTICS_LOG=1
# Optional: comma-separated brandIds for demo tiles
# EXPO_PUBLIC_HUBBLE_DEMO_BRAND_IDS=
# Optional: Hubble Partner JWT only (three dot-separated segments). Not InstaHelp sessionToken.
# EXPO_PUBLIC_HUBBLE_USER_JWT=
