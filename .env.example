# InstaHelp — copy to `.env` and fill in values (never commit `.env`)

# Google Sheet backend (Apps Script web app URL) — required for sign-in + profile
EXPO_PUBLIC_APPS_SCRIPT_URL=

# Support
# EXPO_PUBLIC_WHATSAPP_E164=

# Brand / legal (optional — defaults to instahelp.in)
# EXPO_PUBLIC_APP_WEB_URL=https://instahelp.in
# EXPO_PUBLIC_LEGAL_TERMS_URL=
# EXPO_PUBLIC_LEGAL_PRIVACY_URL=

# Hubble Gift Card SDK (EXPO_PUBLIC_* = baked into the app at build time via app.config.js)
# Local dev: set both values in `.env`. Preview/production APK: also add them in Expo → Environment
# variables for the `preview` / `production` environments, then run a new EAS build (reinstall APK).
# eas.json only sets EXPO_PUBLIC_HUBBLE_ENV; client ID + secret must come from EAS or `.env`.
EXPO_PUBLIC_HUBBLE_CLIENT_ID=
EXPO_PUBLIC_HUBBLE_APP_SECRET=
# development | production (preview/production EAS profiles use production in eas.json)
EXPO_PUBLIC_HUBBLE_ENV=development
# EXPO_PUBLIC_HUBBLE_ANALYTICS_LOG=1
# EXPO_PUBLIC_HUBBLE_DEMO_BRAND_IDS=
# Dev-only: paste a freshly minted JWT (npm run mint:hubble-jwt) to skip Apps Script during local testing
# EXPO_PUBLIC_HUBBLE_USER_JWT=
#
# JWT SSO backend (Apps Script → Project settings → Script properties):
#   Recommended — run: npm run encode:hubble-private-key
#   HUBBLE_JWT_PRIVATE_KEY_B64 = single-line output from that command
#   Or HUBBLE_JWT_PRIVATE_KEY = full private_key.pem (multi-line; often breaks in UI)
#   HUBBLE_CLIENT_ID = instahelp-sdk-1z4JmIpo (optional)
#   Do NOT use EXPO_PUBLIC_HUBBLE_APP_SECRET here — that is not the JWT private key.

# Vendor marketplace catalog: local_json (default, bundled CSV) | firestore (after migration)
# EXPO_PUBLIC_VENDOR_CATALOG_SOURCE=local_json

# InstaHelp Shop catalog — live (default) | bundled_csv (offline fallback)
# EXPO_PUBLIC_SHOP_CATALOG_SOURCE=live
# EXPO_PUBLIC_SHOP_SHEET_ID=1XfPC6fcV_Ct97vDwaRJDVbZ2hJNQRvj2FWj0nddqwR4
# EXPO_PUBLIC_SHOP_PRODUCTS_GID=0
# Optional published CSV id (leave empty if using shared export link):
# EXPO_PUBLIC_SHOP_SHEET_PUBLISH_ID=

# Cuelinks — Shop + Deals affiliate tracking
# Web script: var cId = '284356' (linksredirect.com channel)
# Docs: https://developers.cuelinks.com/docs/reference/links/convert
# Android SDK (optional native): https://www.cuelinks.com/android-installation
EXPO_PUBLIC_CUELINKS_PUBLISHER_ID=284356
EXPO_PUBLIC_CUELINKS_CHANNEL_ID=284356
# Optional API token for /pub_api/v3/links/convert + offers (request from sales@cuelinks.com)
# EXPO_PUBLIC_CUELINKS_API_TOKEN=

# InstaHelp CMS — dynamic content API (banners, categories, shop, mobile assets)
# Point to your deployed CMS API (e.g. https://cms-api.instahelp.in or http://localhost:4000)
# EXPO_PUBLIC_CMS_API_URL=http://localhost:4000

# Firebase (Auth + Firestore + Storage)
# Prefer adding `google-services.json` from Firebase Console (same folder as this file — gitignored).
# `app.config.js` copies it into native Android builds and derives EXPO_PUBLIC_FIREBASE_* if unset.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Functions region (optional; defaults to us-central1 in code)
# EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Explore plans — Razorpay Key ID (public). Key secret lives in Apps Script Script properties.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_SxW7oDR9YnHxcV

# ─── Google Apps Script (NOT Google Sheet cells) ─────────────────────────────
# 1. Paste scripts/code.gs into your Apps Script project (Extensions → Apps Script)
# 2. Project settings → enable "Show appsscript.json manifest" → paste scripts/appsscript.json
# 3. Project settings → Script properties → add:
#      RAZORPAY_KEY_ID     = rzp_live_SxW7oDR9YnHxcV
#      RAZORPAY_KEY_SECRET = (your secret — never put in .env or a sheet)
# 4. Run authorizeExploreServices() once in the editor (grants UrlFetchApp for Razorpay)
# 5. Deploy → New deployment → Web app (Execute as: Me, Access: Anyone)
# 6. Set EXPO_PUBLIC_APPS_SCRIPT_URL below to that deploy URL
#
# Sheet tabs ExploreSubscriptions + ExplorePayments are created automatically
# when the first order/payment runs — you do NOT type Razorpay keys into the sheet.
